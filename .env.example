NODE_ENV=development
PORT=4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

DATABASE_URL=postgres://saferide:saferide@localhost:5432/saferide
# Leave REDIS_URL empty to use the in-memory location store (dev only)
REDIS_URL=

# M-Pesa (Daraja). With MPESA_ENV=mock no network calls are made.
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/v1/payments/mpesa/callback
MPESA_CALLBACK_SECRET=change-me-callback
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=

# Africa's Talking. With AT_USERNAME empty, SMS is logged to the console.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Business rules
DISPATCH_INITIAL_RADIUS_KM=3
DISPATCH_MAX_RADIUS_KM=8
DRIVER_ACCEPT_TIMEOUT_SEC=20
BASE_FARE_KES=300
PER_KM_KES=40
PER_MIN_WAIT_KES=5
MIN_FARE_KES=500
NIGHT_SURGE_START=23:00
NIGHT_SURGE_END=04:00
NIGHT_SURGE_MULTIPLIER=1.5
PLATFORM_COMMISSION_PCT=20
CANCEL_GRACE_SEC=120
CANCEL_FEE_KES=100
# Comma-separated phone numbers that become ADMIN on first login (dev convenience)
ADMIN_PHONES=+254700000000
RATE_LIMIT_AUTH_PER_MIN=120
